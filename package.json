{
  "name": "anhel-frontend-library",
  "version": "0.4.0",
  "private": true,
  "description": "Reusable React components (TypeScript + CSS modules), shipped as source.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./video-entry": "./src/components/video-entry/index.ts",
    "./framed-photo-stack": "./src/components/framed-photo-stack/index.ts",
